}

.admin-page-title {
    font-family: Georgia, serif;
    font-size: 26px;
    font-weight: 400;
}

.admin-user-info {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--text-secondary);
}

.admin-avatar {
    width: 36px;
    height: 36px;
    background: var(--gray-disabled-bg);
