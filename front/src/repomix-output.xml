.filter-pill {
    padding: 7px 18px;
    border-radius: 30px;
    border: 1px solid var(--gray-border);
    background: var(--bg-white);
    font-family: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: all 0.18s;
}

.filter-pill:hover { background: var(--gray-disabled-bg); }

.filter-pill.active {
    background: var(--red-default);
    color: white;
    border-color: var(--red-default);
}

/* ===== Menu admin ===== */
.menu-admin-layout {
    display: flex;
    gap: 24px;
    margin-top: 20px;
}

.categories-panel {
    width: 260px;
    flex-shrink: 0;
    background: var(--bg-white);
    border: 1px solid var(--gray-border);
    border-radius: 16px;
    padding: 18px;
}

.dishes-panel {
    flex: 1;
    background: var(--bg-white);
    border: 1px solid var(--gray-border);
    border-radius: 16px;
    padding: 18px;
}

.cat-item {
    padding: 9px 11px;
    border-radius: 9px;
    cursor: pointer;
    font-size: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: background 0.15s;
    margin-bottom: 2px;
}

.cat-item:hover { background: var(--gray-disabled-bg); }

.cat-item.active {
    background: rgba(192,57,43,0.08);
    color: var(--red-default);
    font-weight: 500;
}

.dish-img-thumb {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    background: var(--gray-disabled-bg);
    object-fit: cover;
}
